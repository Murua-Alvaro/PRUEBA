<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Command Center | Plataforma de Inteligencia de Activos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    <style>
        :root {
            --bg-color: #f0f2f5;
            --sidebar-bg: #131a26;
            --card-bg: #ffffff;
            --text-primary: #121f3e;
            --text-secondary: #5a6474;
            --border-color: #e5e9f2;
            --accent-primary: #0052cc;
            --accent-secondary: #4c9aff;
            --sidebar-text: #c0c6d1;
            --sidebar-text-hover: #ffffff;
            --shadow: 0 6px 20px rgba(0,0,0,0.07);
            --success: #00875a;
            --warning: #ffab00;
            --danger: #de350b;
            --info: #0065ff;
        }

        *, *::before, *::after { box-sizing: border-box; }

        body { 
            font-family: 'Inter', sans-serif; 
            background-color: var(--bg-color); 
            color: var(--text-primary); 
            margin: 0; 
            padding: 0; 
            -webkit-font-smoothing: antialiased; 
            -moz-osx-font-smoothing: grayscale; 
            overflow: hidden;
        }
        
        .container { display: flex; height: 100vh; width: 100vw; }
        
        h1, h2, h3, h4, h5 { margin: 0; font-weight: 600; font-family: 'Roboto Mono', monospace; letter-spacing: -0.5px; }

        /* --- Sidebar --- */
        .sidebar {
            width: 280px;
            background-color: var(--sidebar-bg);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            transition: width 0.3s ease;
            flex-shrink: 0;
        }
        .sidebar-header { margin-bottom: 2rem; padding: 0 0.5rem; }
        .sidebar-header h1 { font-size: 1.25rem; color: var(--sidebar-text-hover); }
        .sidebar-nav { display: flex; flex-direction: column; gap: 0.5rem; }
        .nav-item {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.85rem 1rem; border-radius: 8px;
            color: var(--sidebar-text); text-decoration: none;
            font-weight: 500; transition: all 0.2s ease;
        }
        .nav-item:hover { background-color: #2a3447; color: var(--sidebar-text-hover); }
        .nav-item.active { background-color: var(--accent-primary); color: white; }
        .nav-item svg { width: 20px; height: 20px; }

        .sidebar-footer { margin-top: auto; padding: 0 0.5rem; }
        .asset-selector select {
            width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid #3c465b;
            background-color: #2a3447; color: white; font-family: 'Inter', sans-serif; font-weight: 500;
        }
        #location-status { 
            font-size: 0.8rem; color: var(--sidebar-text); margin-top: 1rem; text-align: center; font-family: 'Inter'; 
        }

        /* --- Main Content --- */
        .main-content { flex: 1; padding: 2rem 3rem; overflow-y: auto; }
        .main-header { margin-bottom: 2rem; }
        .main-header h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); }
        .main-header p { font-family: 'Inter'; font-size: 1rem; color: var(--text-secondary); margin-top: 0.25rem; }
        
        .grid-container { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1.5rem; }
        
        .card { 
            background-color: var(--card-bg); border-radius: 12px; padding: 1.5rem; 
            border: 1px solid var(--border-color); box-shadow: var(--shadow); 
            display: flex; flex-direction: column;
            animation: fadeIn 0.5s ease-out forwards;
        }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .card.col-span-12 { grid-column: span 12; }
        .card.col-span-8 { grid-column: span 8; }
        .card.col-span-7 { grid-column: span 7; }
        .card.col-span-6 { grid-column: span 6; }
        .card.col-span-5 { grid-column: span 5; }
        .card.col-span-4 { grid-column: span 4; }
        
        .card-title { font-size: 1rem; color: var(--text-secondary); margin-bottom: 1rem; font-weight: 500; font-family: 'Inter'; }
        
        /* --- General UI Components --- */
        details { border: 1px solid var(--border-color); border-radius: 8px; margin-bottom: 0.75rem; }
        details[open] { border-color: var(--accent-secondary); background-color: #fcfdff; }
        summary { cursor: pointer; padding: 0.8rem 1rem; font-weight: 500; display: flex; justify-content: space-between; align-items: center; list-style: none; }
        summary::-webkit-details-marker { display: none; }
        .details-content { padding: 1rem; font-size: 0.9rem; color: var(--text-secondary); border-top: 1px solid var(--border-color); }
        .kpi-item { display: flex; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid var(--border-color); }
        .kpi-item:last-child { border-bottom: none; }
        .kpi-label { font-weight: 500; font-family: 'Inter';}
        .kpi-value { font-weight: 600; font-family: 'Roboto Mono'; }

        /* --- Loader --- */
        #loader-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(255, 255, 255, 0.7);
            display: flex; justify-content: center; align-items: center;
            z-index: 9999; flex-direction: column; gap: 1rem;
            backdrop-filter: blur(5px);
            transition: opacity 0.3s ease;
        }
        .spinner {
            width: 56px; height: 56px; border-radius: 50%;
            border: 6px solid var(--border-color);
            border-top-color: var(--accent-primary);
            animation: spin 1s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* --- Specific Component Styles --- */
        #ndvi-canvas-container, #risk-matrix-container {
            position: relative;
            width: 100%;
            padding-top: 75%; /* 4:3 Aspect Ratio */
            background: #e9ecef;
            border-radius: 8px;
        }
        #risk-matrix-container { padding-top: 100%; } /* 1:1 Aspect Ratio */
        #ndvi-canvas, #risk-matrix-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }
    </style>
</head>
<body>

<div id="loader-overlay">
    <div class="spinner"></div>
    <h3 id="loader-text">Obteniendo ubicación...</h3>
</div>

<div class="container">
    <aside class="sidebar">
        <div class="sidebar-header"><h1>AGRO-COMMAND</h1></div>
        <nav class="sidebar-nav" id="main-nav">
             <a href="#" class="nav-item active" data-view="dashboard">
                 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                 <span>Dashboard</span>
             </a>
             <a href="#" class="nav-item" data-view="satellite">
                 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-1.414v.01m0-8.01v.01m-4.01-4.01v.01m0 8.01v.01m8.01 4.01v.01m-4.01-4.01v.01m0 8.01v.01m0-8.01v.01"></path></svg>
                 <span>Datos Geoespaciales</span>
             </a>
             <a href="#" class="nav-item" data-view="agronomy">
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path></svg>
                 <span>Análisis Agronómico</span>
             </a>
             <a href="#" class="nav-item" data-view="finance">
                 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                 <span>Inteligencia Financiera</span>
             </a>
             <a href="#" class="nav-item" data-view="risk">
                 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                 <span>Gestión de Riesgos</span>
             </a>
             <a href="#" class="nav-item" data-view="supplychain">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V7a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <span>Logística y Suministro</span>
             </a>
        </nav>
        <div class="sidebar-footer">
            <h5 style="color: var(--sidebar-text); font-size: 0.8rem; margin-bottom: 0.5rem;">Activo Actual</h5>
            <div class="asset-selector">
                <select id="asset-selector">
                    <option value="corn" data-stage="vegetative">Sinaloa - Maíz V24</option>
                    <option value="chile" data-stage="flowering">Jalisco - Chile S12</option>
                    <option value="cucumber" data-stage="fruiting">Sonora - Pepino F4</option>
                </select>
            </div>
            <p id="location-status">📍Buscando...</p>
        </div>
    </aside>

    <main class="main-content" id="main-content">
        <!-- Contenido dinámico se renderizará aquí -->
    </main>
</div>

<script>
class CommandCenterApp {
    constructor() {
        this.state = {
            currentView: 'dashboard',
            currentAsset: 'corn',
            currentStage: 'vegetative',
            location: null,
            isLoading: true
        };
        this.model = new StrategicConsultingModel();
        this.charts = {}; // To hold chart instances
        this.init();
    }

    init() {
        document.getElementById('main-nav').addEventListener('click', e => this.handleNavClick(e));
        document.getElementById('asset-selector').addEventListener('change', e => this.handleAssetChange(e));
        this.getUserLocation();
    }
    
    setLoading(status, text) {
        this.state.isLoading = status;
        const loader = document.getElementById('loader-overlay');
        const loaderText = document.getElementById('loader-text');
        loader.style.opacity = status ? '1' : '0';
        loader.style.pointerEvents = status ? 'all' : 'none';
        if (text) loaderText.textContent = text;
    }

    getUserLocation() {
        this.setLoading(true, "Obteniendo ubicación...");
        if (!navigator.geolocation) {
            this.state.location = { lat: 19.43, lon: -99.13, name: "CDMX (Default)" };
            this.runSimulation();
            return;
        }
        navigator.geolocation.getCurrentPosition(
            async (position) => {
                const coords = { lat: position.coords.latitude, lon: position.coords.longitude };
                const name = await this.getCityName(coords);
                this.state.location = { ...coords, name };
                document.getElementById('location-status').textContent = `📍 ${name}`;
                this.runSimulation();
            },
            () => {
                this.state.location = { lat: 19.43, lon: -99.13, name: "CDMX (Default)" };
                document.getElementById('location-status').textContent = `📍 ${this.state.location.name}`;
                this.runSimulation();
            }
        );
    }

    async getCityName({ lat, lon }) {
        try {
            const response = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lon}&localityLanguage=es`);
            const data = await response.json();
            return data.city ? `${data.city}, ${data.principalSubdivisionCode.replace('MX-','')}` : "Ubicación Desconocida";
        } catch (e) { return "Ubicación Actual"; }
    }
    
    async fetchForecast({ lat, lon }) {
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&daily=temperature_2m_max,temperature_2m_min,precipitation_sum,shortwave_radiation_sum,relative_humidity_2m_mean,et0_fao_evapotranspiration&timezone=auto&forecast_days=14`;
        try {
            const response = await fetch(url);
            if (!response.ok) throw new Error('Network response was not ok');
            return await response.json();
        } catch (error) {
            console.error("Failed to fetch forecast:", error);
            return null;
        }
    }

    async runSimulation() {
        if (!this.state.location) return;
        this.setLoading(true, `Analizando datos para ${this.state.location.name}...`);
        const forecastData = await this.fetchForecast(this.state.location);
        if (!forecastData) {
            alert("No se pudieron obtener los datos climáticos. Por favor, intente de nuevo.");
            this.setLoading(false);
            return;
        }
        this.data = this.model.generateData(this.state.currentAsset, this.state.currentStage, forecastData);
        this.render();
        this.setLoading(false);
    }
    
    handleNavClick(e) {
        e.preventDefault();
        const navItem = e.target.closest('.nav-item');
        if (navItem && navItem.dataset.view !== this.state.currentView) {
            this.state.currentView = navItem.dataset.view;
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            navItem.classList.add('active');
            this.render();
        }
    }

    handleAssetChange(e) {
        const selectedOption = e.target.options[e.target.selectedIndex];
        this.state.currentAsset = e.target.value;
        this.state.currentStage = selectedOption.dataset.stage;
        this.runSimulation();
    }

    destroyCharts() {
        Object.values(this.charts).forEach(chart => chart?.destroy());
        this.charts = {};
    }

    render() {
        this.destroyCharts();
        const mainContent = document.getElementById('main-content');
        let viewHTML = '';
        switch(this.state.currentView) {
            case 'dashboard': viewHTML = this.renderDashboardView(); break;
            case 'satellite': viewHTML = this.renderSatelliteView(); break;
            case 'agronomy': viewHTML = this.renderAgronomyView(); break;
            case 'finance': viewHTML = this.renderFinanceView(); break;
            case 'risk': viewHTML = this.renderRiskView(); break;
            case 'supplychain': viewHTML = this.renderSupplyChainView(); break;
        }
        mainContent.innerHTML = viewHTML;
        
        // Post-render actions
        if (this.state.currentView === 'satellite') {
            this.initializeNdviCanvas();
            this.initializeSensorChart();
        }
        if (this.state.currentView === 'agronomy') this.initializeAgronomyChart();
        if (this.state.currentView === 'finance') {
            this.initializeFinanceChart();
            this.initializeCashflowChart();
            this.initializeBudgetChart();
            this.initializeMarketChart();
        }
        if (this.state.currentView === 'risk') this.initializeRiskMatrixCanvas();
    }

    // --- RENDER METHODS ---

    renderDashboardView() { 
        const summary = this.data.executiveSummary;
        const color = `var(--${summary.status.toLowerCase()})`;
        return `
            <header class="main-header">
                <h2>Dashboard Ejecutivo</h2>
                <p>Vista consolidada del rendimiento, riesgos y oportunidades del activo.</p>
            </header>
            <div class="grid-container">
                <div class="card col-span-12" style="background-color: ${color}1A;">
                    <div style="display: flex; gap: 1.5rem; align-items: center;">
                        <div style="font-size: 3rem;">${summary.icon}</div>
                        <div>
                            <h3 style="color: ${color}; margin-bottom: 0.5rem;">${summary.title}</h3>
                            <p style="font-family: 'Inter'; font-size: 0.9rem;">${summary.assessment}</p>
                        </div>
                    </div>
                </div>
                <div class="card col-span-4">
                    <h4 class="card-title">Proyección de Rendimiento</h4>
                    <div style="text-align:center; margin: auto;">
                         <h2 style="font-size: 3rem; color: var(--accent-primary);">${this.data.yield.value.toFixed(1)}</h2>
                         <p style="font-size: 1rem; color: var(--text-secondary);">${this.data.yield.unit}</p>
                    </div>
                </div>
                 <div class="card col-span-4">
                    <h4 class="card-title">Rentabilidad Estimada (ROI)</h4>
                    <div style="text-align:center; margin: auto;">
                         <h2 style="font-size: 3rem; color: var(--${this.data.financialServices.overallRoi > 15 ? 'success' : 'warning'});">${this.data.financialServices.overallRoi.toFixed(1)}%</h2>
                         <p style="font-size: 1rem; color: var(--text-secondary);">Margen sobre la inversión total</p>
                    </div>
                </div>
                <div class="card col-span-4">
                    <h4 class="card-title">Índice de Riesgo Compuesto</h4>
                     <div style="text-align:center; margin: auto;">
                         <h2 style="font-size: 3rem; color: var(--${this.data.risk.overall > 65 ? 'danger' : this.data.risk.overall > 40 ? 'warning' : 'success'});">${this.data.risk.overall.toFixed(0)}/100</h2>
                         <p style="font-size: 1rem; color: var(--text-secondary);">Nivel de Exposición General</p>
                    </div>
                </div>
            </div>
        `;
    }

    renderSatelliteView() {
        const satellite = this.data.satellite;
        return `
            <header class="main-header">
                <h2>Hub de Datos Geoespaciales y de Campo</h2>
                <p>Análisis de imágenes satelitales y telemetría de sensores en tiempo real.</p>
            </header>
            <div class="grid-container">
                <div class="card col-span-7">
                    <h4 class="card-title">Mapa de Vigor del Cultivo (NDVI Simulado)</h4>
                    <div id="ndvi-canvas-container"><canvas id="ndvi-canvas"></canvas></div>
                </div>
                <div class="card col-span-5">
                    <h4 class="card-title">Telemetría de Sensores de Campo (Últimos 7 días)</h4>
                    <div style="position: relative; height: 350px;"><canvas id="sensorChart"></canvas></div>
                </div>
            </div>
        `;
    }

    renderAgronomyView() {
        const agronomy = this.data.agronomy;
        return `
            <header class="main-header">
                <h2>Análisis Agronómico Profundo</h2>
                <p>Monitoreo de condiciones bioclimáticas, hídricas y estado fenológico del cultivo.</p>
            </header>
            <div class="grid-container">
                <div class="card col-span-8">
                     <h4 class="card-title">Proyección Climática y GDD (14 días)</h4>
                     <div style="position: relative; height: 300px;"><canvas id="agronomyChart"></canvas></div>
                </div>
                 <div class="card col-span-4">
                     <h4 class="card-title">Seguimiento Fenológico</h4>
                     <div class="kpi-item"><span class="kpi-label">Etapa Actual</span><span class="kpi-value">${agronomy.phenology.stage}</span></div>
                     <div class="kpi-item"><span class="kpi-label">GDD Acumulados</span><span class="kpi-value">${agronomy.phenology.gddAccumulated.toFixed(0)} GDD</span></div>
                     <div class="kpi-item"><span class="kpi-label">Progreso a Madurez</span><span class="kpi-value">${agronomy.phenology.progressToNextStage.toFixed(0)}%</span></div>
                     <div class="kpi-item"><span class="kpi-label">Días para Próx. Etapa</span><span class="kpi-value">~${agronomy.phenology.daysToNextStage}</span></div>
                </div>
                <div class="card col-span-12">
                     <h4 class="card-title">Balance Hídrico del Cultivo</h4>
                     <details>
                         <summary>Ver análisis hídrico detallado</summary>
                         <div class="details-content grid-container">
                             <div class="col-span-4"><strong>Precipitación Acumulada:</strong><br>${agronomy.waterBalance.totalPrecip.toFixed(1)} mm</div>
                             <div class="col-span-4"><strong>ETc Acumulada:</strong><br>${agronomy.waterBalance.totalEtc.toFixed(1)} mm</div>
                             <div class="col-span-4"><strong>Balance Hídrico Neto:</strong><br><span style="color: var(--${agronomy.waterBalance.netBalance > 0 ? 'success':'danger'})">${agronomy.waterBalance.netBalance.toFixed(1)} mm</span></div>
                             <div class="col-span-12" style="margin-top: 1rem;"><strong>Recomendación de Riego:</strong> ${agronomy.waterBalance.recommendation}</div>
                         </div>
                     </details>
                </div>
                <div class="card col-span-12">
                    <h4 class="card-title">Presión de Plagas y Enfermedades</h4>
                    <details>
                        <summary>Ver análisis de riesgo fitosanitario</summary>
                        <div class="details-content">
                            <div class="kpi-item">
                                <span class="kpi-label">Nivel de Riesgo General</span>
                                <span class="kpi-value" style="color: var(--${agronomy.diseasePressure.level.toLowerCase() === 'alto' ? 'danger' : agronomy.diseasePressure.level.toLowerCase() === 'moderado' ? 'warning' : 'success'}">${agronomy.diseasePressure.level}</span>
                            </div>
                            <h5 style="margin-top: 1rem; margin-bottom: 0.5rem; font-family: 'Inter'; font-weight: 600;">Amenazas Primarias Detectadas:</h5>
                            ${agronomy.diseasePressure.primaryThreats.map(threat => `
                                <div class="kpi-item">
                                    <span class="kpi-label">${threat.name}</span>
                                    <span class="kpi-value">${threat.risk}</span>
                                </div>
                            `).join('')}
                            <p style="margin-top: 1rem;"><strong>Recomendación Preventiva:</strong> ${agronomy.diseasePressure.recommendation}</p>
                        </div>
                    </details>
                </div>
            </div>
        `;
    }
    
    renderFinanceView() {
        const market = this.data.financialServices.marketAnalysis;
        return `
            <header class="main-header">
                <h2>Inteligencia Financiera y Consultoría</h2>
                <p>Análisis de rentabilidad, proyecciones y servicios estratégicos para maximizar el valor del activo.</p>
            </header>
            <div class="grid-container">
                <div class="card col-span-6">
                    <h4 class="card-title">Análisis de Rentabilidad de Inversión (ROI)</h4>
                    <div style="position: relative; height: 250px;"><canvas id="financeChart"></canvas></div>
                </div>
                <div class="card col-span-6">
                    <h4 class="card-title">Benchmarking de Desempeño</h4>
                    ${this.data.financialServices.benchmarking.map(item => `
                        <div class="kpi-item">
                            <span class="kpi-label">${item.metric}</span>
                            <span class="kpi-value" style="color: var(--${item.performance > 0 ? 'success' : 'danger'})">${item.value} (${item.performance > 0 ? '+' : ''}${item.performance.toFixed(1)}%)</span>
                        </div>
                    `).join('')}
                </div>
                <div class="card col-span-12">
