    initializeRiskMatrixCanvas() {
        const canvas = document.getElementById('risk-matrix-canvas');
        if (!canvas) return;
        const container = document.getElementById('risk-matrix-container');
        const ctx = canvas.getContext('2d');
        canvas.width = container.clientWidth;
        canvas.height = container.clientHeight;

        const padding = 40;
        const width = canvas.width - padding * 2;
        const height = canvas.height - padding * 2;
        
        ctx.strokeStyle = '#ccc';
        ctx.fillStyle = '#666';
        ctx.font = '12px Inter';
        
        // Draw grid
        ctx.strokeRect(padding, padding, width, height);
        ctx.beginPath();
        ctx.moveTo(padding + width / 2, padding);
        ctx.lineTo(padding + width / 2, padding + height);
        ctx.moveTo(padding, padding + height / 2);
        ctx.lineTo(padding + width, padding + height / 2);
        ctx.stroke();

        // Draw labels
        ctx.textAlign = 'center';
        ctx.fillText('Baja Probabilidad', padding + width / 4, padding - 10);
        ctx.fillText('Alta Probabilidad', padding + (width * 3) / 4, padding - 10);
        ctx.save();
        ctx.translate(padding - 10, padding + height / 2);
        ctx.rotate(-Math.PI / 2);
        ctx.fillText('Alto Impacto', 0, -(height / 4));
        ctx.fillText('Bajo Impacto', 0, (height / 4));
        ctx.restore();

        // Draw risks as bubbles
        this.data.risk.components.forEach(risk => {
            const x = padding + (risk.probabilityValue * width);
            const y = padding + ((1 - risk.impactValue) * height);
            const radius = 5 + (risk.financialExposure * 20);
            
            ctx.beginPath();
            const color = risk.score > 65 ? 'rgba(222, 53, 11, 0.6)' : risk.score > 40 ? 'rgba(255, 171, 0, 0.6)' : 'rgba(0, 135, 90, 0.6)';
            ctx.fillStyle = color;
            ctx.arc(x, y, radius, 0, 2 * Math.PI);
            ctx.fill();

            ctx.fillStyle = '#fff';
            ctx.font = 'bold 10px Inter';
            ctx.fillText(risk.name.substring(0,3).toUpperCase(), x, y + 3);
        });
    }
}


class StrategicConsultingModel {
    // This class is a comprehensive simulation engine.
    generateData(assetKey, stageKey, forecastData) {
        const rand = (min, max) => Math.random() * (max - min) + min;
        
        const dailyData = forecastData.daily.time.map((time, i) => ({
            max_temp: forecastData.daily.temperature_2m_max[i], min_temp: forecastData.daily.temperature_2m_min[i],
            precip: forecastData.daily.precipitation_sum[i], humidity: forecastData.daily.relative_humidity_2m_mean[i],
        }));

        const cropParams = {
            corn: { baseTemp: 10, gddToMaturity: 1500, baseYield: 12, price: 180, costs: 1200, name: 'Maíz Blanco' },
            chile: { baseTemp: 12, gddToMaturity: 1800, baseYield: 30, price: 800, costs: 4500, name: 'Chile Serrano' },
            cucumber: { baseTemp: 15, gddToMaturity: 1200, baseYield: 24, price: 350, costs: 2800, name: 'Pepino' },
        };
        const params = cropParams[assetKey];
        const gdd = dailyData.map(d => Math.max(0, ((d.max_temp + d.min_temp) / 2) - params.baseTemp));
        let cumulativeGdd = 0;
        const gddTrace = gdd.map(d => cumulativeGdd += d);
        const gddAccumulated = gddTrace[gddTrace.length - 1];

        const tempStressDays = dailyData.filter(d => d.max_temp > 35).length;
        const droughtStressDays = dailyData.filter(d => d.precip < 1).length;
        const diseasePressureDays = dailyData.filter(d => d.humidity > 80 && d.max_temp > 20).length;

        const tempRisk = Math.min(100, (tempStressDays / 14) * 150);
        const precipRisk = Math.min(100, (droughtStressDays / 14) * 120);
        const diseaseRisk = Math.min(100, (diseasePressureDays / 14) * 100);
        const marketRisk = rand(30, 80);
        const operationalRisk = rand(20, 50);
        const overallRisk = (tempRisk + precipRisk + diseaseRisk + marketRisk + operationalRisk) / 5;
        
        const yieldModifier = (100 - (tempRisk * 0.5 + precipRisk * 0.4 + diseaseRisk * 0.1)) / 100;
        const finalYield = params.baseYield * yieldModifier * rand(0.95, 1.05);
        const revenue = finalYield * params.price * 100;
        const costs = params.costs * 100;
        const overallRoi = ((revenue - costs) / costs) * 100;

        const totalCost = params.costs;
        const budget = [
            { category: 'Fertilizantes', cost: totalCost * 0.35 },
            { category: 'Fitosanitarios', cost: totalCost * 0.20 },
            { category: 'Mano de Obra', cost: totalCost * 0.25 },
            { category: 'Combustible', cost: totalCost * 0.10 },
            { category: 'Otros', cost: totalCost * 0.10 },
        ];
        
        const data = {
            executiveSummary: {},
            yield: { value: finalYield, unit: "ton/ha" },
            satellite: {
                ndviGrid: Array.from({ length: 20 }, () => Array.from({ length: 30 }, () => rand(0.2, 0.9))),
                sensorData: {
                    labels: Array.from({ length: 7 }, (_, i) => `Día ${i+1}`),
                    soilMoisture: Array.from({ length: 7 }, () => rand(25, 45)),
                    nitrogen: Array.from({ length: 7 }, () => rand(100, 150))
                }
            },
            agronomy: {
                climateSeries: {
                    days: forecastData.daily.time.map(t => new Date(t)),
                    maxTemp: forecastData.daily.temperature_2m_max,
                    precip: forecastData.daily.precipitation_sum,
                },
                phenology: {
                    stage: "Llenado de Grano (R3)", gddAccumulated,
                    progressToNextStage: (gddAccumulated / params.gddToMaturity) * 100,
                    daysToNextStage: ((params.gddToMaturity - gddAccumulated) / (gddAccumulated / 14)).toFixed(0),
                    gddTrace: gddTrace
                },
                waterBalance: {
                    totalPrecip: dailyData.reduce((acc, day) => acc + day.precip, 0),
                    totalEtc: dailyData.reduce((acc, day) => acc + rand(3.5, 6.0), 0),
                    get netBalance() { return this.totalPrecip - this.totalEtc; },
                    get recommendation() { return this.netBalance < -10 ? "Déficit hídrico detectado. Se recomienda un riego suplementario de 15mm en los próximos 2 días." : "Niveles de humedad adecuados. Monitorear ETc y mantener riego estándar."; }
                },
                diseasePressure: {
                    level: diseaseRisk > 70 ? "Alto" : diseaseRisk > 40 ? "Moderado" : "Bajo",
                    primaryThreats: diseaseRisk > 40 ? [{name: "Roya (Puccinia sorghi)", risk:"Alto"}, {name:"Tizón foliar (Exserohilum turcicum)", risk:"Moderado"}] : [{name: "Sin amenazas significativas", risk:"Bajo"}],
                    recommendation: diseaseRisk > 70 ? "Riesgo ALTO detectado. Realizar aplicación inmediata de fungicida sistémico y aumentar la frecuencia de monitoreo a cada 2 días." :
                                    diseaseRisk > 40 ? "Riesgo MODERADO. Considerar una aplicación de fungicida preventivo y monitorear la evolución de las condiciones climáticas." :
                                    "Las condiciones son de bajo riesgo. Continuar con el monitoreo semanal estándar."
                }
            },
            financialServices: {
                overallRoi,
                roiAnalysis: [
                    { investment: "Riego de Precisión", roi: precipRisk > 50 ? rand(25,35) : rand(15,22) },
                    { investment: "Drones de Monitoreo", roi: rand(12, 18) },
                    { investment: "Enmiendas Orgánicas", roi: rand(22, 30) },
                ],
                benchmarking: [
                    { metric: 'Rendimiento (ton/ha)', value: `${finalYield.toFixed(1)} vs ${ (params.baseYield * 0.9).toFixed(1)}`, performance: (finalYield / (params.baseYield * 0.9) - 1) * 100 },
                    { metric: 'Costo ($/ha)', value: `${params.costs} vs ${params.costs * 1.1}`, performance: (1 - (params.costs / (params.costs * 1.1))) * 100 },
                ],
                budget: budget,
                hedging: {
                    volatility: marketRisk > 65 ? "ALTA" : "MODERADA",
                    recommendation: marketRisk > 65 
                        ? "La volatilidad del mercado es ALTA. Se recomienda asegurar el 50% de la producción esperada mediante contratos de futuros para bloquear un precio de venta rentable."
                        : "La volatilidad es MODERADA. Considere comprar opciones de venta (put options) para protegerse de caídas de precios."
                },
                supplyChain: {
                    analysis: "Los costos de fertilizantes nitrogenados han aumentado un 12% en el último trimestre.",
                    recommendation: "Realizar compras consolidadas de insumos para acceder a descuentos por volumen."
                },
                cashflow: {
                    months: ["Oct", "Nov", "Dic", "Ene", "Feb", "Mar"],
                    revenues: [0, 0, 0, 0, revenue * 0.8, revenue * 0.2],
                    expenses: [costs*0.1, costs*0.1, costs*0.2, costs*0.4, costs*0.1, costs*0.1]
                },
                marketAnalysis: {
                    commodity: params.name,
                    currentPrice: params.price * rand(0.98, 1.03),
                    futures3m: params.price * rand(1.02, 1.08),
                    futures6m: params.price * rand(1.05, 1.15),
                    trend: marketRisk > 50 ? 'Alcista' : 'Estable',
                    insights: [
                        "La demanda de exportación se ha incrementado un 8% en el último mes.",
                        "Condiciones climáticas adversas en regiones competidoras están afectando la oferta global.",
                        "Los costos de logística internacional han subido un 5%, lo cual podría presionar los márgenes de ganancia."
                    ],
                    priceForecast: {
                        months: ["Oct", "Nov", "Dic", "Ene", "Feb", "Mar"],
                        prices: Array.from({length: 6}, (_, i) => params.price * (1 + (i * 0.02)) * rand(0.98, 1.02))
                    }
                }
            },
            risk: {
                overall: overallRisk,
                components: [
                    { name: "Estrés Térmico", score: tempRisk, probability: 'Media', impact: 'Crítico', mitigation: 'Aplicar riego de enfriamiento y bioestimulantes.', probabilityValue: rand(0.4, 0.7), impactValue: rand(0.7, 0.95), financialExposure: rand(0.7, 1.0) },
                    { name: "Déficit Hídrico", score: precipRisk, probability: 'Alta', impact: 'Crítico', mitigation: 'Optimizar calendario de riego basado en ETc.', probabilityValue: rand(0.7, 0.95), impactValue: rand(0.7, 0.95), financialExposure: rand(0.8, 1.0) },
                    { name: "Presión Fúngica", score: diseaseRisk, probability: 'Baja', impact: 'Significativo', mitigation: 'Monitoreo constante y aplicaciones preventivas.', probabilityValue: rand(0.2, 0.4), impactValue: rand(0.5, 0.7), financialExposure: rand(0.3, 0.6) },
                    { name: "Volatilidad de Mercado", score: marketRisk, probability: 'Media', impact: 'Alto', mitigation: 'Implementar estrategia de hedging.', probabilityValue: rand(0.4, 0.6), impactValue: rand(0.6, 0.8), financialExposure: rand(0.5, 0.8) },
                    { name: "Fallas Operacionales", score: operationalRisk, probability: 'Baja', impact: 'Moderado', mitigation: 'Mantenimiento preventivo de maquinaria.', probabilityValue: rand(0.1, 0.3), impactValue: rand(0.3, 0.5), financialExposure: rand(0.2, 0.4) }
                ],
                shapAnalysis: [] // Filled below
            }
        };
        
        data.risk.shapAnalysis = data.risk.components
            .map(r => ({ name: r.name, impact: r.score / overallRisk / 5 * rand(0.8, 1.2), mitigation: r.mitigation }))
            .sort((a,b) => b.impact - a.impact);
        
        if (overallRisk > 65) data.executiveSummary = { title: "Alerta Crítica: Riesgos Elevados", status: "Danger", icon: "🔥", assessment: "La combinación de estrés climático y volatilidad de mercado presenta una amenaza significativa. Se requiere acción inmediata para implementar estrategias de mitigación." };
        else if (overallRisk > 40) data.executiveSummary = { title: "Escenario de Precaución", status: "Warning", icon: "⚠️", assessment: "Se detectan riesgos moderados que podrían impactar la rentabilidad. Se recomienda una revisión proactiva de los planes de contingencia." };
        else data.executiveSummary = { title: "Condiciones Favorables", status: "Success", icon: "✅", assessment: "El perfil de riesgo es bajo y las condiciones son óptimas. Es un momento ideal para enfocarse en la maximización de la eficiencia y la captura de oportunidades de mercado." };
        
        return data;
    }
}

